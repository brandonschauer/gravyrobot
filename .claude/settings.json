{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "permissions": {
    "defaultMode": "default",

    "allow": [
      "Read",

      "Bash(pwd)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(stat:*)",
      "Bash(file:*)",
      "Bash(du:*)",
      "Bash(echo:*)",
      "Bash(which:*)",

      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",

      "Bash(sips -g:*)",

      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch)",
      "Bash(git remote -v)",
      "Bash(git config --get:*)"
    ],

    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git checkout --force:*)",
      "Bash(git checkout -f:*)",
      "Bash(git clean -f:*)",
      "Bash(git clean -d:*)",
      "Bash(git clean -x:*)",
      "Bash(git branch -D:*)",
      "Bash(git stash drop:*)",
      "Bash(git stash clear)",
      "Bash(git filter-branch:*)",
      "Bash(git reflog expire:*)",
      "Bash(git gc --prune:*)",
      "Bash(git update-ref -d:*)",

      "Bash(rm -rf:*)",

      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/id_rsa*)"
    ]
  },

  "fileCheckpointingEnabled": true,
  "autoCompactEnabled": true,
  "respectGitignore": true,
  "includeGitInstructions": true,
  "cleanupPeriodDays": 90
}
